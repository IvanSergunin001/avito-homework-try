# Пример окружения. Настоящий файл — `.env` (он в .gitignore и в репозиторий не попадает):
#
#     cp .env.example .env
#
# Значения ниже совпадают с умолчаниями: `docker compose up` работает и без `.env`.
# Конфигурация служб читается только из переменных окружения; файлов конфигурации нет.

# --- PostgreSQL ---------------------------------------------------------------
# Один инстанс на обе службы (у каждой своя схема) — экономия на инфраструктуре демо.
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
# Порт, на котором база видна с хоста.
POSTGRES_PORT=5432

# --- Площадка -----------------------------------------------------------------
# Порт площадки: служба слушает его внутри контейнера, Compose публикует под тем же
# номером на хост.
PLATFORM_HTTP_PORT=8080
# Сколько ждать завершения начатых запросов после сигнала остановки.
PLATFORM_SHUTDOWN_TIMEOUT=10s
# Минимальный уровень записи в лог: debug, info, warn, error.
PLATFORM_LOG_LEVEL=info
# Админский токен площадки: им опознаются администратор, подключающий заведения, и
# саппорт. Значения по умолчанию в коде у него нет — без токена служба не поднимается:
# токен, зашитый в бинарь, известен всем, кто видел репозиторий, а этим токеном меняется
# адрес заведения, то есть то, куда уходят чужие заказы. Значение ниже — демонстрационное,
# в эксплуатации сюда идёт секрет из хранилища секретов.
PLATFORM_ADMIN_TOKEN=demo-admin-token
# Как часто площадка сама забирает меню у каждого работающего заведения. Интервал живёт
# конфигурацией, а не константой: он балансирует свежесть витрины против нагрузки на
# чужие системы, и подбирается в эксплуатации. Заведению, которому ждать очередного цикла
# долго, ждать и не нужно — оно зовёт внеочередное обновление
# (`POST /api/partner/v1/catalog/refresh`).
PLATFORM_CATALOG_SYNC_INTERVAL=30s
# Сколько площадка ждёт заведение, забирая у него страницу меню. Без таймаута заведение,
# принявшее соединение и замолчавшее, останавливало бы синхронизацию всех остальных.
PLATFORM_CATALOG_SYNC_TIMEOUT=15s
# База площадки. Внутри Compose хост — имя сервиса `postgres`; значение подставляет
# `compose.yaml`, поэтому переопределять его в `.env` нужно только при запуске службы
# в обход Compose.
PLATFORM_DATABASE_DSN=postgres://kitchen:kitchen@postgres:5432/kitchen?sslmode=disable

# --- Коробка заведения --------------------------------------------------------
# Порт коробки заведения.
RESTAURANT_HTTP_PORT=8081
RESTAURANT_SHUTDOWN_TIMEOUT=10s
RESTAURANT_LOG_LEVEL=info
# База коробки. Инстанс общий с площадкой, схема своя (`restaurant`); значение
# подставляет `compose.yaml`.
RESTAURANT_DATABASE_DSN=postgres://kitchen:kitchen@postgres:5432/kitchen?sslmode=disable
