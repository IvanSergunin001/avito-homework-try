' C4 Level 2 — контейнеры. Исходник диаграммы; картинка рождается из него командой
' `make diagrams` и лежит в `docs/img`. Правится здесь, а не в графическом редакторе:
' диаграмма, нарисованная руками, расходится с кодом на первой же правке.
@startuml c4_container
!include <C4/C4_Container>

title Авито.Кухня — C4 Level 2: контейнеры

Person(customer, "Покупатель", "Ищет блюдо, оформляет заказ и следит за ним. Аутентификации нет: приходит с идентификатором в заголовке User-Id")
Person(operator, "Оператор заведения", "Ведёт меню и стоп-лист, разбирает входящие заказы и двигает их по кухне")
Person(support, "Администратор и саппорт площадки", "Подключает заведения и отменяет заказы по обращению заведения")

System_Boundary(platform_org, "Площадка (Авито)") {
    Container(platform, "platform", "Go 1.27, chi", "Витрина заведений и меню, оформление заказа и его статусы, партнёрская и админская поверхности. Каталог забирает у заведений сама")
    ContainerDb(platform_db, "Схема platform", "PostgreSQL 18", "Заведения, товары витрины, заказы, журнал состояний заказа")
}

System_Boundary(restaurant_org, "Заведение (другая организация)") {
    Container(box, "restaurant — коробка заведения", "Go 1.27, chi", "Готовый бэкенд для заведения без своих систем: меню, стоп-лист, остатки, приём заказов, рабочее место оператора, очередь уведомлений")
    ContainerDb(box_db, "Схема restaurant", "PostgreSQL 18", "Позиции меню с остатками, входящие заказы, очередь уведомлений о статусе")
}

System_Ext(own_system, "Своя система заведения", "Альтернатива коробке: заведение реализует тот же партнёрский контракт у себя")

Rel(customer, platform, "Витрина, меню, поиск, оформление заказа, статус и отмена", "HTTPS /api/v1, JSON")
Rel(support, platform, "Онбординг заведения, отмена заказа через саппорт", "HTTPS /api/admin/v1, Bearer")
Rel(operator, box, "Меню, стоп-лист, остатки, входящие заказы, продвижение статусов", "HTTPS /api/operator/v1, JSON")

Rel(platform, box, "Забирает меню страницами, передаёт заказ, сообщает об отмене", "HTTPS /api/v1 партнёрского контракта, Bearer")
Rel_U(box, platform, "Уведомляет о смене статуса заказа, просит обновить каталог вне очереди", "HTTPS /api/partner/v1, Bearer")
Rel(platform, own_system, "Тот же партнёрский контракт: заведению со своей системой коробка не нужна", "HTTPS, Bearer")

Rel(platform, platform_db, "Читает и пишет", "SQL, database/sql")
Rel(box, box_db, "Читает и пишет", "SQL, database/sql")

note as demo
  На демо-стенде обе схемы живут в одном инстансе PostgreSQL и не связаны
  ни одним внешним ключом — это экономия на инфраструктуре демо.
  В эксплуатации инстанс у каждой службы свой: заведение — другая
  организация, и общая база означала бы, что партнёр физически
  дотягивается до данных площадки.
end note
demo .. platform_db
demo .. box_db

SHOW_LEGEND()
@enduml
